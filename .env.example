# SignBridge Environment Variables Template
# Copy this file to .env and fill in the actual values
# NEVER commit .env to version control!

# ============================================================================
# PROJECT PATHS
# ============================================================================

# Path to the dataset directory (ASL Citizen videos)
# This should point to the location where you've placed the ASL Citizen dataset
DATASET_PATH=/path/to/your/dataset/directory

# Path to the videos directory within the dataset
VIDEOS_PATH=${DATASET_PATH}/ASL_Citizen/videos

# Path to the splits directory (train/test splits)
SPLITS_PATH=${DATASET_PATH}/ASL_Citizen/splits

# ============================================================================
# MODEL CHECKPOINTS
# ============================================================================

# Production model checkpoint path
# Place your best model checkpoint here
PRODUCTION_MODEL_PATH=/path/to/your/production_model.pth

# Fallback model checkpoint path (used if production model doesn't exist)
FALLBACK_MODEL_PATH=/path/to/your/fallback_model.pth

# ============================================================================
# CACHE DIRECTORIES
# ============================================================================

# Landmark cache directories (will be auto-generated if missing)
LANDMARK_CACHE_PATH=landmark_cache
LANDMARK_INTERPOLATION_CACHE_PATH=landmark_interpolation_cache
LANDMARK_POSE_CACHE_PATH=landmark_pose_cache
LANDMARK_CACHE_FULL_PATH=landmark_cache_full

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# FastAPI server configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS configuration
# Set to specific origins in production, "*" for development
CORS_ORIGINS=*

# ============================================================================
# PERFORMANCE & HARDWARE
# ============================================================================

# PyTorch device configuration
# Options: 'cpu', 'cuda', 'mps' (Apple Silicon), or auto-detect
TORCH_DEVICE=auto

# MediaPipe configuration
MEDIAPIPE_HANDS_MODEL_PATH=/path/to/mediapipe/hand_landmarker.task
MEDIAPIPE_POSE_MODEL_PATH=/path/to/mediapipe/pose_landmarker_lite.task

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable features
ENABLE_LEARN_MODE=true
ENABLE_PRACTICE_MODE=true
ENABLE_DIAGNOSTICS=true
ENABLE_TWO_WAY_MODE=true

# Debug mode settings
DEBUG=false
LOG_LEVEL=INFO

# ============================================================================
# KOKORO NEURAL TEXT-TO-SPEECH (TTS) CONFIGURATION
# ============================================================================

# Local Kokoro ONNX model path
KOKORO_MODEL_PATH=models/kokoro/kokoro-v0_19.onnx

# Local Kokoro voices asset path
KOKORO_VOICES_PATH=models/kokoro/voices.bin

# Default Voice Identifier (options: af_sarah, af_bella, af_nicole, af_sky, am_adam, am_michael, bf_emma, bf_isabella, bm_george, bm_lewis)
KOKORO_VOICE_ID=af_sarah

# ============================================================================
# SPEECH-TO-TEXT (STT) CONFIGURATION
# ============================================================================

# Primary STT Provider ('webspeech_primary' uses client Web Speech API with zero latency)
STT_PROVIDER=webspeech_primary

# Server-side fallback STT endpoint (optional, e.g. for headless browsers or cloud Whisper)
STT_API_URL=
STT_API_KEY=your_stt_api_key_here
STT_LANGUAGE=en-US

# ============================================================================
# DATA FILES
# ============================================================================

# Gloss definition files
DEMO_READY_GLOSSES_FILE=signbridge_demo_ready_glosses.csv
ELITE_GLOSSES_FILE=signbridge_elite_glosses.csv
FINAL_DEMO_GLOSSES_FILE=signbridge_final_demo_glosses.csv

# ============================================================================
# WEB APPLICATION
# ============================================================================

# Static files and templates
STATIC_DIR=signbridge/web/static
TEMPLATES_DIR=signbridge/web/templates

# ============================================================================
# TRAINING CONFIGURATION
# ============================================================================

# Training hyperparameters (if doing local training)
BATCH_SIZE=32
LEARNING_RATE=0.001
EPOCHS=50
VALIDATION_SPLIT=0.2

# ============================================================================
# NOTES FOR TEAMMATES
# ============================================================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Update the paths to match your local setup
#
# 3. For dataset setup:
#    - Place ASL Citizen dataset in DATASET_PATH
#    - Structure should be: dataset/ASL_Citizen/{videos, splits, ...}
#
# 4. For model setup:
#    - Place trained model checkpoints (.pth files) in appropriate locations
#    - Update PRODUCTION_MODEL_PATH and FALLBACK_MODEL_PATH
#
# 5. Cache directories will be auto-generated when needed
#
# 6. Never commit .env to Git!
#